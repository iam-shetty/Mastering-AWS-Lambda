{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Action": [
                "ec2:DescribeInstances",
                "ec2:ModifyInstanceAttribute",
                "ec2:CreateSnapshot",
                "iam:PutRolePolicy",
                "iam:DeleteRolePolicy",
                "sns:Publish",
                "logs:*"
            ],
            "Resource": "*"
        }
    ]
}